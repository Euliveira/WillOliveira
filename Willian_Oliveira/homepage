            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
                <button onclick="scrollToSection('servicos')" class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-red-600 via-red-500 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-extrabold font-orbitron rounded-xl border-2 border-white shadow-lg glow-red transform hover:-translate-y-1 transition duration-200 flex items-center justify-center space-x-3 text-base">
