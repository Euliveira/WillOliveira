                        <div>
                            <p class="text-sm font-bold text-gray-200 group-hover:text-sky-400">Telegram Oficial</p>
                            <p class="text-[10px] text-gray-400">Chat Seguro End-to-End</p>
                        </div>
                    </button>

                    <button onclick="window.open('https://instagram.com/seuoperacional', '_blank')" class="w-full flex items-center space-x-3 p-3 rounded-lg bg-gray-900/80 hover:bg-pink-950/40 hover:border-pink-500/50 border border-transparent transition text-left group">
