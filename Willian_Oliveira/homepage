    <!-- SCRIPTS -->
    <script>
        const MEU_WHATSAPP = "5516993741367"; 

        lucide.createIcons();

        const contactBtn = document.getElementById('contactMenuBtn');
        const contactDropdown = document.getElementById('contactDropdown');
        const contactArrow = document.getElementById('contactArrow');

        contactBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            contactDropdown.classList.toggle('hidden');
            contactArrow.classList.toggle('rotate-180');
        });

        document.addEventListener('click', () => {
            contactDropdown.classList.add('hidden');
            contactArrow.classList.remove('rotate-180');
        });

        function scrollToSection(id) {
            document.getElementById(id).scrollIntoView({ behavior: 'smooth' });
        }

        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        function redirecionarWhatsApp(tipo) {
            let textoMensagem = "";

            switch(tipo) {
                case 'CNPJ':
                    textoMensagem = "Quero consultar CNPJ.";
                    break;
                case 'WhatsApp / Telefone':
                    textoMensagem = "Quero consultar telefone / WhatsApp.";
                    break;
                case 'E-mail':
                    textoMensagem = "Quero consultar e-mail.";
                    break;
                case 'Endereço':
                    textoMensagem = "Quero consultar endereço.";
                    break;
                case 'Servico: Identificação de Pessoas':
                    textoMensagem = "Preciso de uma consulta: Identificação de Pessoas.";
                    break;
                case 'Servico: Rastreamento de Ativos':
                    textoMensagem = "Preciso de uma consulta: Rastreamento Avançado de Ativos.";
                    break;
                case 'Servico: Assédio em Redes Sociais':
                    textoMensagem = "Preciso de uma consulta: Combate a Assédio em Redes Sociais.";
                    break;
                case 'Servico: Auxílio Jurídico':
                    textoMensagem = "Preciso de uma consulta: Auxílio em Processos Jurídicos.";
                    break;
                default:
                    textoMensagem = "Quero fazer o orçamento.";
            }

            const mensagemEncoded = encodeURIComponent(textoMensagem);
            window.open(`https://wa.me/${MEU_WHATSAPP}?text=${mensagemEncoded}`, '_blank');
        }

        // GLOBO 3D HOLOGRÁFICO
        function initGlobe() {
            const container = document.getElementById('globe-container');
            const scene = new THREE.Scene();
            
            const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.z = 220;

            const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            container.appendChild(renderer.domElement);

            const mainGroup = new THREE.Group();
            scene.add(mainGroup);

            // 1. Esfera Interna
            const innerGeo = new THREE.IcosahedronGeometry(60, 4);
            const innerMat = new THREE.MeshBasicMaterial({
                color: 0x3b82f6,
                wireframe: true,
                transparent: true,
                opacity: 0.25
            });
            const innerGlobe = new THREE.Mesh(innerGeo, innerMat);
            mainGroup.add(innerGlobe);

            // 2. Pontos Iluminados
            const particlesGeo = new THREE.BufferGeometry();
            const particleCount = 700;
            const posArray = new Float32Array(particleCount * 3);

            for (let i = 0; i < particleCount * 3; i += 3) {
                const u = Math.random();
                const v = Math.random();
                const theta = u * 2.0 * Math.PI;
                const phi = Math.acos(2.0 * v - 1.0);
                const r = 62 + (Math.random() * 4);

                posArray[i] = r * Math.sin(phi) * Math.cos(theta);
                posArray[i + 1] = r * Math.sin(phi) * Math.sin(theta);
                posArray[i + 2] = r * Math.cos(phi);
            }

            particlesGeo.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
            const particlesMat = new THREE.PointsMaterial({
                size: 1.8,
                color: 0x06b6d4,
                transparent: true,
                opacity: 0.8
            });
            const particleSystem = new THREE.Points(particlesGeo, particlesMat);
            mainGroup.add(particleSystem);

            // 3. Anéis de Órbita Holográficos
            const ringGeo1 = new THREE.RingGeometry(80, 81.5, 64);
            const ringMat1 = new THREE.MeshBasicMaterial({ color: 0xef4444, side: THREE.DoubleSide, transparent: true, opacity: 0.5 });
            const ring1 = new THREE.Mesh(ringGeo1, ringMat1);
            ring1.rotation.x = Math.PI / 2.3;
            ring1.rotation.y = Math.PI / 6;
            mainGroup.add(ring1);

            const ringGeo2 = new THREE.RingGeometry(95, 96, 64);
            const ringMat2 = new THREE.MeshBasicMaterial({ color: 0x3b82f6, side: THREE.DoubleSide, transparent: true, opacity: 0.3 });
            const ring2 = new THREE.Mesh(ringGeo2, ringMat2);
            ring2.rotation.x = -Math.PI / 3;
            mainGroup.add(ring2);

            mainGroup.rotation.z = 0.2;

            function animate() {
                requestAnimationFrame(animate);

                innerGlobe.rotation.y += 0.0025;
                particleSystem.rotation.y += 0.0025;
                
                ring1.rotation.z += 0.003;
                ring2.rotation.z -= 0.002;

                renderer.render(scene, camera);
            }

            animate();

            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });
        }

        window.onload = initGlobe;
    </script>
</body>
</html>
