                    <span>CONTATO SEGURO</span>
                    <i data-lucide="chevron-down" class="w-4 h-4 transition-transform duration-200" id="contactArrow"></i>
                </button>

                <!-- DROPDOWN CONTATOS -->
                <div id="contactDropdown" class="hidden absolute right-0 mt-3 w-64 bg-gray-950/95 border border-blue-900/60 rounded-xl shadow-2xl backdrop-blur-lg p-3 z-50 space-y-2">
                    <div class="text-[11px] font-mono text-gray-400 px-3 py-1 border-b border-gray-800 flex justify-between items-center">
                        <span>CANAIS CRIPTOGRAFADOS</span>
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                    </div>

                    <button onclick="redirecionarWhatsApp('Orcamento')" class="w-full flex items-center space-x-3 p-3 rounded-lg bg-gray-900/80 hover:bg-emerald-950/40 hover:border-emerald-500/50 border border-transparent transition text-left group">
