                    <button onclick="window.open('https://t.me/seuusername', '_blank')" class="w-full flex items-center space-x-3 p-3 rounded-lg bg-gray-900/80 hover:bg-sky-950/40 hover:border-sky-500/50 border border-transparent transition text-left group">
